{
  "name": "trustgate-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:login": "node src/index.js --login",
    "login:setup": "node scripts/setup-login.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "demo": "node scripts/demo.js",
    "postgres:setup": "node scripts/setup-postgres.js",
    "start:postgres": "node src/index.js --postgres",
    "start:gemini": "node src/index.js --postgres --gemini",
    "gemini:check": "node scripts/check-gemini.js"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "pg": "8.23.1"
  }
}
